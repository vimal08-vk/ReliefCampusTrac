      "name": "01. Camps",
      "item": [
        {
          "name": "01 - Get All Camps",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/camps",
              "host": ["{{baseUrl}}"],
              "path": ["api", "camps"]
            },
            "description": "Fetches all registered relief camps with their current capacity and occupancy metrics."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});",
                  "if (jsonData.length > 0) {",
                  "    pm.environment.set(\"campId\", jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
